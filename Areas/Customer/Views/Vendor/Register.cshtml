@model ShopSphere.ViewModels.VendorRegistrationViewModel

@{
    ViewData["Title"] = "Become a Seller";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h2 class="mb-2">Become a Seller</h2>

                    <p class="text-muted mb-4">
                        Create your store and start selling on ShopSphere.
                    </p>

                    <form asp-action="Register" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="StoreName"
                                   class="form-label"></label>

                            <input asp-for="StoreName"
                                   class="form-control"
                                   placeholder="Enter your store name" />

                            <span asp-validation-for="StoreName"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="StoreDescription"
                                   class="form-label"></label>

                            <textarea asp-for="StoreDescription"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Tell customers about your store">
                            </textarea>

                            <span asp-validation-for="StoreDescription"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="StoreAddress"
                                   class="form-label"></label>

                            <input asp-for="StoreAddress"
                                   class="form-control"
                                   placeholder="Enter store address" />

                            <span asp-validation-for="StoreAddress"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="City"
                                       class="form-label"></label>

                                <input asp-for="City"
                                       class="form-control"
                                       placeholder="City" />

                                <span asp-validation-for="City"
                                      class="text-danger">
                                </span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Country"
                                       class="form-label"></label>

                                <input asp-for="Country"
                                       class="form-control"
                                       value="Bangladesh"
                                       placeholder="Country" />

                                <span asp-validation-for="Country"
                                      class="text-danger">
                                </span>
                            </div>

                        </div>

                        <div class="d-flex gap-2 mt-4">

                            <button type="submit"
                                    class="btn btn-primary">
                                Submit Application
                            </button>

                            <a asp-area="Customer"
                               asp-controller="Home"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}