@model IEnumerable<ShopSphere.Models.Product>

@{
    ViewData["Title"] = "Shop Products";

    var search = ViewBag.Search?.ToString() ?? "";
    int? selectedCategoryId = ViewBag.CategoryId as int?;
    var categories = ViewBag.Categories as IEnumerable<ShopSphere.Models.Category>
                     ?? Enumerable.Empty<ShopSphere.Models.Category>();
}

<div class="container py-5">

    <!-- ===================================================== -->
    <!-- PAGE HEADER -->
    <!-- ===================================================== -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>
            <h1 class="fw-bold mb-2">
                Shop Products 🛍️
            </h1>

            <p class="text-muted mb-0">
                Discover products available on ShopSphere.
            </p>
        </div>

        <div class="d-flex gap-2">

            <!-- Categories -->
            <a asp-area="Customer"
               asp-controller="Products"
               asp-action="Index"
               class="btn btn-outline-primary">
                📁 Categories
            </a>

            <!-- Cart -->
            <a asp-area="Customer"
               asp-controller="Cart"
               asp-action="Index"
               class="btn btn-primary">
                🛒 My Cart
            </a>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- SEARCH + CATEGORY FILTER -->
    <!-- ===================================================== -->
    <form asp-area="Customer"
          asp-controller="Products"
          asp-action="Index"
          method="get"
          class="card border-0 shadow-sm rounded-4 p-3 mb-4">

        <div class="row g-3 align-items-end">

            <!-- Search -->
            <div class="col-lg-5 col-md-6">

                <label class="form-label fw-semibold">
                    Search Products
                </label>

                <input type="text"
                       name="search"
                       value="@search"
                       class="form-control"
                       placeholder="🔎 Search products..." />

            </div>


            <!-- Category -->
            <div class="col-lg-4 col-md-6">

                <label class="form-label fw-semibold">
                    Category
                </label>

                <select name="categoryId"
                        class="form-select">

                    <option value="">
                        📁 All Categories
                    </option>

                    @foreach (var category in categories)
                    {
                        if (selectedCategoryId == category.Id)
                        {
                            <option value="@category.Id" selected>
                                @category.Name
                            </option>
                        }
                        else
                        {
                            <option value="@category.Id">
                                @category.Name
                            </option>
                        }
                    }

                </select>

            </div>


            <!-- Buttons -->
            <div class="col-lg-3 col-md-12 d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary flex-grow-1">
                    🔎 Search
                </button>

                <a asp-area="Customer"
                   asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Clear
                </a>

            </div>

        </div>

    </form>


    <!-- ===================================================== -->
    <!-- ACTIVE FILTER INFORMATION -->
    <!-- ===================================================== -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">

        <div>

            @if (!string.IsNullOrWhiteSpace(search) && selectedCategoryId.HasValue)
            {
                <h3 class="fw-bold mb-1">
                    Filtered Products
                </h3>

                <small class="text-muted">
                    Search: "@search"
                    · Category:
                    @(categories.FirstOrDefault(c => c.Id == selectedCategoryId.GetValueOrDefault())?.Name
    ?? "Selected Category")
                </small>
            }
            else if (!string.IsNullOrWhiteSpace(search))
            {
                <h3 class="fw-bold mb-1">
                    Search Results
                </h3>

                <small class="text-muted">
                    Results for "@search"
                </small>
            }
            else if (selectedCategoryId.HasValue)
            {
                <h3 class="fw-bold mb-1">
                    Category Products
                </h3>

                <small class="text-muted">
                    @(categories.FirstOrDefault(c => c.Id == selectedCategoryId.Value)?.Name
                        ?? "Selected Category")
                </small>
            }
            else
            {
                <h3 class="fw-bold mb-0">
                    All Products
                </h3>
            }

        </div>


        <span class="badge bg-light text-dark border px-3 py-2">
            @Model.Count() product(s)
        </span>

    </div>


    <!-- ===================================================== -->
    <!-- PRODUCTS -->
    <!-- ===================================================== -->
    @if (Model.Any())
    {
        <div class="row g-4">

            @foreach (var product in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">

                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">

                        <!-- Product Image -->
                        <div class="p-3">

                            @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl"
                                     alt="@product.Name"
                                     class="img-fluid rounded-3 w-100"
                                     style="height:200px; object-fit:cover;" />
                            }
                            else
                            {
                                <div class="bg-light rounded-3 d-flex align-items-center justify-content-center"
                                     style="height:200px; font-size:65px;">
                                    📦
                                </div>
                            }

                        </div>


                        <!-- Product Information -->
                        <div class="card-body d-flex flex-column">

                            <!-- Category -->
                            <span class="badge bg-light text-dark border align-self-start mb-2">

                                📁 @(product.Category?.Name ?? "Uncategorized")

                            </span>


                            <!-- Product Name -->
                            <h5 class="fw-bold mb-2">
                                @product.Name
                            </h5>


                            <!-- Description -->
                            @if (!string.IsNullOrWhiteSpace(product.Description))
                            {
                                <p class="text-muted small mb-3">

                                    @(product.Description.Length > 80
                                        ? product.Description.Substring(0, 80) + "..."
                                        : product.Description)

                                </p>
                            }


                            <div class="mt-auto">

                                <!-- Price -->
                                <div class="fw-bold text-primary fs-5 mb-2">
                                    ৳ @product.Price.ToString("N2")
                                </div>


                                <!-- Stock -->
                                @if (product.StockQuantity <= 10)
                                {
                                    <div class="text-warning small mb-3">
                                        ⚠️ Only @product.StockQuantity left
                                    </div>
                                }
                                else
                                {
                                    <div class="text-success small mb-3">
                                        ✅ In stock
                                    </div>
                                }


                                <!-- Details -->
                                <a asp-area="Customer"
                                   asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="btn btn-primary w-100">

                                    👁 View Product

                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- ================================================= -->
        <!-- EMPTY RESULT -->
        <!-- ================================================= -->
        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body text-center py-5">

                <div style="font-size:70px;">
                    🔎
                </div>

                <h3 class="fw-bold mt-3">
                    No Products Found
                </h3>

                <p class="text-muted mb-4">
                    No products match your current search or category filter.
                </p>

                <a asp-area="Customer"
                   asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-primary">
                    ← View All Products
                </a>

            </div>

        </div>
    }

</div>