@model IEnumerable<ShopSphere.Models.Wishlist>

@{
    ViewData["Title"] = "My Wishlist";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">❤️ My Wishlist</h1>
            <p class="text-muted mb-0">
                Products you saved for later.
            </p>
        </div>

        <a asp-area="Customer"
           asp-controller="Products"
           asp-action="Index"
           class="btn btn-outline-primary">
            🛍️ Continue Shopping
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info">
            @TempData["InfoMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm text-center p-5">
            <div style="font-size: 4rem;">💔</div>

            <h3 class="fw-bold mt-3">
                Your Wishlist is Empty
            </h3>

            <p class="text-muted">
                Save products you love and find them here later.
            </p>

            <div>
                <a asp-area="Customer"
                   asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-primary">
                    🛍️ Browse Products
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                var product = item.Product;

                if (product == null)
                {
                    continue;
                }

                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">

                    <div class="card h-100 border-0 shadow-sm">

                        <div class="position-relative bg-light"
                             style="height: 220px;">

                            @if (!string.IsNullOrWhiteSpace(
                                product.ImageUrl))
                            {
                                <img src="@product.ImageUrl"
                                     alt="@product.Name"
                                     class="w-100 h-100"
                                     style="object-fit: cover;" />
                            }
                            else
                            {
                                <div class="d-flex justify-content-center
                                    align-items-center h-100"
                                     style="font-size: 4rem;">
                                    📦
                                </div>
                            }

                            <span class="position-absolute top-0 end-0
                                m-2 badge bg-danger">
                                ❤️ Saved
                            </span>

                        </div>

                        <div class="card-body d-flex flex-column">

                            @if (product.Category != null)
                            {
                                <div class="mb-2">
                                    <span class="badge bg-light text-dark
                                        border">
                                        📁 @product.Category.Name
                                    </span>
                                </div>
                            }

                            <h5 class="card-title fw-bold">
                                @product.Name
                            </h5>

                            @if (!string.IsNullOrWhiteSpace(
                                product.Description))
                            {
                                <p class="card-text text-muted small">
                                    @(product.Description.Length > 90
                                        ? product.Description[..90] + "..."
                                        : product.Description)
                                </p>
                            }

                            <div class="mt-auto">

                                <div class="fs-5 fw-bold text-primary mb-3">
                                    ৳ @product.Price.ToString("N2")
                                </div>

                                @if (product.StockQuantity > 0)
                                {
                                    <div class="small text-success mb-3">
                                        ✅ In stock
                                    </div>
                                }
                                else
                                {
                                    <div class="small text-danger mb-3">
                                        ❌ Out of stock
                                    </div>
                                }

                                <div class="d-grid gap-2">

                                    <a asp-area="Customer"
                                       asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@product.Id"
                                       class="btn btn-primary">
                                        👁️ View Product
                                    </a>

                                    <form asp-area="Customer"
                                          asp-controller="Wishlist"
                                          asp-action="Remove"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="btn btn-outline-danger
                                            w-100">
                                            🗑️ Remove
                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>