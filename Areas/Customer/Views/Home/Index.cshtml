@using ShopSphere.Models

@{
    ViewData["Title"] = "ShopSphere - Online Marketplace";

    var categories = ViewBag.Categories as List<Category>
                     ?? new List<Category>();

    var products = ViewBag.Products as List<Product>
                   ?? new List<Product>();
}

<!-- HERO SECTION -->
<section class="shopsphere-hero">
    <div class="container">
        <div class="row align-items-center g-4">

            <div class="col-lg-7">

                <span class="hero-badge">
                    🛍️ Bangladesh's Smart Multi-Vendor Marketplace
                </span>

                <h1 class="hero-title">
                    Shop Smart.<br />
                    <span class="hero-title-soft">Shop Everything.</span>
                </h1>

                <p class="hero-text">
                    Discover amazing products from trusted sellers,
                    enjoy secure payment and experience shopping
                    with ShopSphere.
                </p>

                <div class="d-flex flex-wrap gap-3 mt-4">

                    <a asp-area="Customer"
                       asp-controller="Products"
                       asp-action="Index"
                       class="btn btn-light btn-lg px-4 fw-bold">
                        🛒 Shop Now
                    </a>

                    <a href="#categories"
                       class="btn btn-outline-light btn-lg px-4">
                        Explore Categories
                    </a>

                </div>

            </div>

            <div class="col-lg-5 text-center">

                <div class="hero-shopping-card">

                    <div class="hero-icon">
                        🛍️
                    </div>

                    <h3 class="fw-bold">
                        Everything You Need
                    </h3>

                    <p class="mb-0">
                        Electronics, fashion, lifestyle
                        and much more.
                    </p>

                </div>

            </div>

        </div>
    </div>
</section>


<!-- TRUST FEATURES -->
<section class="py-4 border-bottom bg-white">

    <div class="container">

        <div class="row g-3 text-center">

            <div class="col-md-3 col-6">

                <div class="trust-item">
                    <div class="trust-icon">🚚</div>

                    <div>
                        <h6 class="fw-bold mb-1">
                            Fast Delivery
                        </h6>

                        <small class="text-muted">
                            Reliable delivery
                        </small>
                    </div>
                </div>

            </div>


            <div class="col-md-3 col-6">

                <div class="trust-item">
                    <div class="trust-icon">🔒</div>

                    <div>
                        <h6 class="fw-bold mb-1">
                            Secure Payment
                        </h6>

                        <small class="text-muted">
                            Safe checkout
                        </small>
                    </div>
                </div>

            </div>


            <div class="col-md-3 col-6">

                <div class="trust-item">
                    <div class="trust-icon">🛡️</div>

                    <div>
                        <h6 class="fw-bold mb-1">
                            Trusted Vendors
                        </h6>

                        <small class="text-muted">
                            Verified sellers
                        </small>
                    </div>
                </div>

            </div>


            <div class="col-md-3 col-6">

                <div class="trust-item">
                    <div class="trust-icon">↩️</div>

                    <div>
                        <h6 class="fw-bold mb-1">
                            Easy Shopping
                        </h6>

                        <small class="text-muted">
                            Simple experience
                        </small>
                    </div>
                </div>

            </div>

        </div>

    </div>

</section>


<!-- CATEGORIES -->
<section id="categories" class="py-5">

    <div class="container">

        <div class="section-heading">

            <div>
                <span class="section-label">
                    DISCOVER
                </span>

                <h2 class="fw-bold mb-1">
                    Shop by Category
                </h2>

                <p class="text-muted mb-0">
                    Find exactly what you're looking for.
                </p>
            </div>

            <a asp-area="Customer"
               asp-controller="Products"
               asp-action="Index"
               class="btn btn-outline-primary">
                View All
            </a>

        </div>


        @if (categories.Any())
        {
            <div class="row g-3">

                @foreach (var category in categories.Take(8))
                {
                    <div class="col-xl-3 col-lg-3 col-md-4 col-6">

                        <a asp-area="Customer"
                           asp-controller="Products"
                           asp-action="Index"
                           asp-route-categoryId="@category.Id"
                           class="text-decoration-none">

                            <div class="category-card">

                                <div class="category-icon">

                                    @if (!string.IsNullOrWhiteSpace(category.ImageUrl))
                                    {
                                        <img src="@category.ImageUrl"
                                             alt="@category.Name"
                                             loading="lazy" />
                                    }
                                    else
                                    {
                                        <span>📦</span>
                                    }

                                </div>

                                <h5 class="fw-bold mb-1">
                                    @category.Name
                                </h5>

                                <span>
                                    Explore Products →
                                </span>

                            </div>

                        </a>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-section">
                <div>📁</div>
                <h5>No categories available</h5>
                <p class="text-muted mb-0">
                    Categories will appear here.
                </p>
            </div>
        }

    </div>

</section>


<!-- FLASH DEALS -->
<section class="py-5 bg-white">

    <div class="container">

        <div class="section-heading">

            <div>
                <span class="section-label text-danger">
                    🔥 HOT DEALS
                </span>

                <h2 class="fw-bold mb-1">
                    Flash Deals
                </h2>

                <p class="text-muted mb-0">
                    Grab our latest products before they're gone.
                </p>
            </div>

            <a asp-area="Customer"
               asp-controller="Products"
               asp-action="Index"
               class="btn btn-outline-primary">
                Shop All
            </a>

        </div>


        @if (products.Any())
        {
            <div class="row g-4">

                @foreach (var product in products.Take(6))
                {
                    <div class="col-xl-2 col-lg-3 col-md-4 col-6">

                        <div class="product-card h-100">

                            <div class="product-image">

                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl"
                                         alt="@product.Name" />
                                }
                                else
                                {
                                    <div class="product-placeholder">
                                        📦
                                    </div>
                                }

                                <span class="product-badge">
                                    NEW
                                </span>

                            </div>


                            <div class="p-3">

                                @if (product.Category != null)
                                {
                                    <small class="text-muted">
                                        @product.Category.Name
                                    </small>
                                }

                                <h6 class="fw-bold product-name mt-1">
                                    @product.Name
                                </h6>

                                <div class="product-price">
                                    ৳@product.Price.ToString("N2")
                                </div>

                                <a asp-area="Customer"
                                   asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="btn btn-primary btn-sm w-100 mt-3">
                                    View Product
                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-section">
                <div>🛍️</div>
                <h5>No products available</h5>
                <p class="text-muted mb-0">
                    Products will appear here when available.
                </p>
            </div>
        }

    </div>

</section>


<!-- FEATURED PRODUCTS -->
<section class="py-5">

    <div class="container">

        <div class="section-heading">

            <div>
                <span class="section-label">
                    ⭐ FEATURED
                </span>

                <h2 class="fw-bold mb-1">
                    Featured Products
                </h2>

                <p class="text-muted mb-0">
                    Explore products available right now.
                </p>
            </div>

            <a asp-area="Customer"
               asp-controller="Products"
               asp-action="Index"
               class="btn btn-primary">
                Explore Shop
            </a>

        </div>


        @if (products.Any())
        {
            <div class="row g-4">

                @foreach (var product in products.Skip(6).Take(6))
                {
                    <div class="col-lg-4 col-md-6">

                        <div class="featured-product-card">

                            <div class="featured-image">

                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl"
                                         alt="@product.Name" />
                                }
                                else
                                {
                                    <div class="product-placeholder">
                                        📦
                                    </div>
                                }

                            </div>


                            <div class="featured-content">

                                @if (product.Category != null)
                                {
                                    <span class="small text-muted">
                                        @product.Category.Name
                                    </span>
                                }

                                <h5 class="fw-bold mt-1">
                                    @product.Name
                                </h5>

                                <p class="text-muted small">
                                    @(string.IsNullOrWhiteSpace(product.Description)
                                        ? "Quality product available on ShopSphere."
                                        : product.Description.Length > 90
                                            ? product.Description.Substring(0, 90) + "..."
                                            : product.Description)
                                </p>

                                <div class="d-flex align-items-center justify-content-between">

                                    <strong class="featured-price">
                                        ৳@product.Price.ToString("N2")
                                    </strong>

                                    <a asp-area="Customer"
                                       asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@product.Id"
                                       class="btn btn-outline-primary btn-sm">
                                        Details
                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</section>


<!-- SELLER CTA -->
<section class="seller-section">

    <div class="container">

        <div class="row align-items-center g-4">

            <div class="col-lg-8">

                <span class="seller-label">
                    🏪 FOR BUSINESS OWNERS
                </span>

                <h2 class="fw-bold mt-2">
                    Start Selling on ShopSphere
                </h2>

                <p class="mb-0">
                    Create your own store, reach more customers
                    and grow your business with our multi-vendor
                    marketplace.
                </p>

            </div>

            <div class="col-lg-4 text-lg-end">

                <a asp-area="Customer"
                   asp-controller="Vendor"
                   asp-action="Register"
                   class="btn btn-light btn-lg px-4 fw-bold">
                    🏪 Become a Seller
                </a>

            </div>

        </div>

    </div>

</section>


<!-- FINAL CTA -->
<section class="py-5 bg-white">

    <div class="container">

        <div class="final-cta text-center">

            <div class="cta-icon">
                🛒
            </div>

            <h2 class="fw-bold">
                Ready to Start Shopping?
            </h2>

            <p class="text-muted">
                Explore thousands of possibilities on ShopSphere.
            </p>

            <a asp-area="Customer"
               asp-controller="Products"
               asp-action="Index"
               class="btn btn-primary btn-lg px-5">
                Start Shopping
            </a>

        </div>

    </div>

</section>


<style>

    /* =========================================
           SHOPSPHERE FULL PAGE WATERMARK
           ========================================= */

    body {
        background: #f7f8fc;
        position: relative;
    }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            background-image: url('/images/shopsphere-logo-watermark.png');
            background-repeat: no-repeat;
            background-position: center center;
            background-size: min(720px, 65vw);
            opacity: 0.055;
            pointer-events: none;
            z-index: 0;
        }

        body > * {
            position: relative;
            z-index: 1;
        }

    .shopsphere-hero {
        padding: 80px 0;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        color: white;
        overflow: hidden;
    }

    .hero-badge {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 50px;
        background: rgba(255,255,255,.15);
        font-size: .9rem;
        margin-bottom: 20px;
    }

    .hero-title {
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        line-height: 1.05;
        font-weight: 800;
        margin-bottom: 20px;
        color: rgba(255, 255, 255, 0.88);
    }

    .hero-title-soft {
        color: rgba(255, 255, 255, 0.62);
    }

    .hero-text {
        max-width: 620px;
        font-size: 1.1rem;
        opacity: .9;
    }

    .hero-shopping-card {
        padding: 45px 30px;
        border-radius: 30px;
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.25);
        backdrop-filter: blur(12px);
    }

    .hero-icon {
        font-size: 90px;
        margin-bottom: 15px;
    }

    .trust-item {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
    }

    .trust-icon {
        font-size: 30px;
    }

    .section-heading {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 28px;
    }

    .section-label {
        display: block;
        font-size: .75rem;
        font-weight: 800;
        letter-spacing: 1.5px;
        margin-bottom: 5px;
        color: #4f46e5;
    }

    .category-card {
        padding: 25px 15px;
        background: white;
        border-radius: 18px;
        text-align: center;
        border: 1px solid #eee;
        transition: all .25s ease;
        height: 100%;
    }

        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0,0,0,.08);
        }

    .category-icon {
        width: 100%;
        height: 150px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        border-radius: 14px;
        background: #f0edff;
        overflow: hidden;
    }

        .category-icon img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .category-icon span {
            font-size: 55px;
        }

    .category-card h5 {
        color: #222;
    }

    .category-card span {
        color: #6b7280;
        font-size: .8rem;
    }

    .product-card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid #eee;
        transition: all .25s ease;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,.1);
        }

    .product-image {
        height: 190px;
        position: relative;
        background: #f3f4f6;
        overflow: hidden;
    }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .product-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        background: #ef4444;
        color: white;
        padding: 4px 8px;
        border-radius: 6px;
        font-size: .7rem;
        font-weight: 700;
    }

    .product-placeholder {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 55px;
    }

    .product-name {
        min-height: 40px;
    }

    .product-price {
        color: #e11d48;
        font-size: 1.1rem;
        font-weight: 800;
    }

    .featured-product-card {
        display: flex;
        height: 100%;
        background: white;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid #eee;
        transition: all .25s ease;
    }

        .featured-product-card:hover {
            box-shadow: 0 12px 30px rgba(0,0,0,.08);
            transform: translateY(-3px);
        }

    .featured-image {
        width: 40%;
        min-height: 190px;
        background: #f3f4f6;
    }

        .featured-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .featured-content {
        width: 60%;
        padding: 20px;
    }

    .featured-price {
        color: #e11d48;
        font-size: 1.1rem;
    }

    .seller-section {
        padding: 55px 0;
        background: linear-gradient(135deg, #111827, #1f2937);
        color: white;
    }

    .seller-label {
        font-size: .75rem;
        font-weight: 800;
        letter-spacing: 1.5px;
        opacity: .8;
    }

    .final-cta {
        padding: 45px 20px;
    }

    .cta-icon {
        font-size: 55px;
        margin-bottom: 10px;
    }

    .empty-section {
        padding: 50px;
        text-align: center;
        background: white;
        border-radius: 18px;
    }

        .empty-section > div {
            font-size: 50px;
            margin-bottom: 10px;
        }

    @@media (max-width: 767px) {

        .shopsphere-hero {
            padding: 55px 0;
        }

        .hero-title {
            font-size: 2.7rem;
        }

        .hero-shopping-card {
            padding: 30px 20px;
        }

        .section-heading {
            align-items: start;
            flex-direction: column;
        }

        .product-image {
            height: 150px;
        }

        .featured-product-card {
            display: block;
        }

        .featured-image,
        .featured-content {
            width: 100%;
        }

        .featured-image {
            height: 200px;
            min-height: auto;
        }

        .trust-item {
            flex-direction: column;
            gap: 3px;
        }
    }

</style>