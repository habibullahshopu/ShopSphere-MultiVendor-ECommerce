@model ShopSphere.Models.CustomerAddress

@{
    ViewData["Title"] = "Add New Address";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <!-- =====================================================
                 HEADER
                 ===================================================== -->

            <div class="mb-4">

                <a asp-area="Customer"
                   asp-controller="Addresses"
                   asp-action="Index"
                   class="btn btn-outline-secondary mb-3">

                    ← Back to My Addresses

                </a>

                <h1 class="fw-bold mb-1">
                    📍 Add New Address
                </h1>

                <p class="text-muted">
                    Add a delivery address for your future orders.
                </p>

            </div>


            <!-- =====================================================
                 FORM CARD
                 ===================================================== -->

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5">

                    <form asp-area="Customer"
                          asp-controller="Addresses"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- VALIDATION -->

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- =================================================
                             PERSONAL INFORMATION
                             ================================================= -->

                        <h5 class="fw-bold mb-3">
                            👤 Contact Information
                        </h5>


                        <div class="row g-3 mb-4">

                            <!-- FULL NAME -->

                            <div class="col-md-6">

                                <label asp-for="FullName"
                                       class="form-label fw-semibold">

                                    Full Name

                                </label>

                                <input asp-for="FullName"
                                       class="form-control"
                                       placeholder="Enter full name" />

                                <span asp-validation-for="FullName"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- PHONE -->

                            <div class="col-md-6">

                                <label asp-for="PhoneNumber"
                                       class="form-label fw-semibold">

                                    Phone Number

                                </label>

                                <input asp-for="PhoneNumber"
                                       class="form-control"
                                       placeholder="01XXXXXXXXX" />

                                <span asp-validation-for="PhoneNumber"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>


                        <!-- =================================================
                             ADDRESS INFORMATION
                             ================================================= -->

                        <h5 class="fw-bold mb-3">
                            🏠 Delivery Address
                        </h5>


                        <!-- ADDRESS LINE -->

                        <div class="mb-3">

                            <label asp-for="AddressLine"
                                   class="form-label fw-semibold">

                                Address

                            </label>

                            <textarea asp-for="AddressLine"
                                      class="form-control"
                                      rows="3"
                                      placeholder="House/Road/Area details"></textarea>

                            <span asp-validation-for="AddressLine"
                                  class="text-danger small">
                            </span>

                        </div>


                        <div class="row g-3">


                            <!-- CITY -->

                            <div class="col-md-6">

                                <label asp-for="City"
                                       class="form-label fw-semibold">

                                    City

                                </label>

                                <input asp-for="City"
                                       class="form-control"
                                       placeholder="Dhaka" />

                                <span asp-validation-for="City"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- STATE -->

                            <div class="col-md-6">

                                <label asp-for="State"
                                       class="form-label fw-semibold">

                                    State / Division

                                </label>

                                <input asp-for="State"
                                       class="form-control"
                                       placeholder="Dhaka Division" />

                                <span asp-validation-for="State"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- POSTAL CODE -->

                            <div class="col-md-6">

                                <label asp-for="PostalCode"
                                       class="form-label fw-semibold">

                                    Postal Code

                                </label>

                                <input asp-for="PostalCode"
                                       class="form-control"
                                       placeholder="1200" />

                                <span asp-validation-for="PostalCode"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- COUNTRY -->

                            <div class="col-md-6">

                                <label asp-for="Country"
                                       class="form-label fw-semibold">

                                    Country

                                </label>

                                <input asp-for="Country"
                                       class="form-control"
                                       value="Bangladesh" />

                                <span asp-validation-for="Country"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>


                        <!-- =================================================
                             DEFAULT ADDRESS
                             ================================================= -->

                        <div class="form-check mt-4 mb-4">

                            <input asp-for="IsDefault"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="IsDefault"
                                   class="form-check-label fw-semibold">

                                ⭐ Set as default delivery address

                            </label>

                        </div>


                        <!-- =================================================
                             BUTTONS
                             ================================================= -->

                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit"
                                    class="btn btn-primary px-4">

                                💾 Save Address

                            </button>


                            <a asp-area="Customer"
                               asp-controller="Addresses"
                               asp-action="Index"
                               class="btn btn-outline-secondary">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}