@model ShopSphere.Models.Category

@{
    ViewData["Title"] = "Add New Category";
}

<style>

    .category-form-page {
        max-width: 1000px;
        margin: 0 auto;
    }

    .form-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .form-page-title h1 {
        font-size: 42px;
        font-weight: 800;
        color: #1f2937;
        margin: 0 0 8px;
    }

    .form-page-title p {
        margin: 0;
        color: #64748b;
        font-size: 17px;
    }

    .btn-back-category {
        display: inline-block;
        padding: 12px 20px;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        color: #475569;
        background: white;
        text-decoration: none;
        font-weight: 600;
        transition: all .2s ease;
    }

    .btn-back-category:hover {
        background: #f8fafc;
        color: #2563eb;
        border-color: #2563eb;
    }

    .category-form-card {
        background: white;
        border-radius: 20px;
        padding: 30px;
        border: 1px solid #eef2f7;
        box-shadow: 0 8px 30px rgba(15, 23, 42, .08);
    }

    .form-label-custom {
        display: block;
        font-size: 16px;
        font-weight: 700;
        color: #334155;
        margin-bottom: 8px;
    }

    .form-control-custom {
        width: 100%;
        border: 1px solid #dbe3ef;
        border-radius: 10px;
        padding: 13px 16px;
        font-size: 16px;
        color: #334155;
        outline: none;
        transition: all .2s ease;
        background: #fff;
    }

    .form-control-custom:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, .10);
    }

    textarea.form-control-custom {
        min-height: 140px;
        resize: vertical;
    }

    .form-group-custom {
        margin-bottom: 22px;
    }

    /* CATEGORY IMAGE UPLOAD */

    .category-image-upload {
        border: 2px dashed #cbd5e1;
        border-radius: 14px;
        padding: 24px;
        background: #f8fafc;
        text-align: center;
        transition: all .2s ease;
    }

    .category-image-upload:hover {
        border-color: #2563eb;
        background: #eff6ff;
    }

    .category-image-upload input[type="file"] {
        width: 100%;
        padding: 12px;
        border: 1px solid #dbe3ef;
        border-radius: 10px;
        background: white;
        cursor: pointer;
    }

    .upload-hint {
        margin-top: 10px;
        color: #64748b;
        font-size: 14px;
    }

    .image-preview-wrapper {
        display: none;
        margin-top: 18px;
    }

    .image-preview {
        width: 180px;
        height: 140px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid #dbe3ef;
        box-shadow: 0 6px 18px rgba(15, 23, 42, .10);
    }

    .preview-label {
        margin-top: 8px;
        font-size: 14px;
        font-weight: 600;
        color: #475569;
    }

    .toggle-wrapper {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 8px 0 28px;
    }

    .toggle-wrapper input[type="checkbox"] {
        width: 20px;
        height: 20px;
        cursor: pointer;
        accent-color: #2563eb;
    }

    .toggle-wrapper label {
        font-size: 16px;
        color: #334155;
        cursor: pointer;
        margin: 0;
    }

    .form-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-top: 5px;
    }

    .btn-save-category {
        border: none;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: white;
        padding: 13px 28px;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 8px 20px rgba(37, 99, 235, .25);
        transition: all .2s ease;
    }

    .btn-save-category:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 25px rgba(37, 99, 235, .35);
    }

    .btn-cancel-category {
        display: inline-block;
        padding: 12px 25px;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        color: #64748b;
        background: white;
        text-decoration: none;
        font-weight: 600;
        transition: .2s;
    }

    .btn-cancel-category:hover {
        color: #dc2626;
        border-color: #dc2626;
        background: #fef2f2;
    }

    .text-danger {
        display: block;
        margin-top: 6px;
        font-size: 14px;
    }

    @@media (max-width: 768px) {

        .form-page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .form-page-title h1 {
            font-size: 32px;
        }

        .category-form-card {
            padding: 20px;
        }

        .form-actions {
            flex-wrap: wrap;
        }

        .image-preview {
            width: 150px;
            height: 120px;
        }
    }

</style>


<div class="category-form-page">

    <!-- Page Header -->
    <div class="form-page-header">

        <div class="form-page-title">
            <h1>Add New Category 📁</h1>
            <p>Create a new product category for your ShopSphere marketplace.</p>
        </div>

        <a asp-action="Index" class="btn-back-category">
            ← Back to Categories
        </a>

    </div>


    <!-- Form Card -->
    <div class="category-form-card">

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <!-- Category Name -->
            <div class="form-group-custom">

                <label asp-for="Name"
                       class="form-label-custom">
                    Category Name
                </label>

                <input asp-for="Name"
                       class="form-control-custom"
                       placeholder="e.g. Electronics" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>

            </div>


            <!-- Description -->
            <div class="form-group-custom">

                <label asp-for="Description"
                       class="form-label-custom">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="form-control-custom"
                          placeholder="Enter category description"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>

            </div>


            <!-- Category Image Upload -->
            <div class="form-group-custom">

                <label class="form-label-custom">
                    Category Image
                </label>

                <div class="category-image-upload">

                    <input type="file"
                           name="imageFile"
                           id="categoryImage"
                           accept=".jpg,.jpeg,.png,.webp" />

                    <div class="upload-hint">
                        JPG, JPEG, PNG or WebP • Maximum 5 MB
                    </div>

                    <div class="image-preview-wrapper"
                         id="imagePreviewWrapper">

                        <img id="imagePreview"
                             class="image-preview"
                             alt="Category image preview" />

                        <div class="preview-label">
                            Image Preview
                        </div>

                    </div>

                </div>

                <span asp-validation-for="ImageUrl"
                      class="text-danger">
                </span>

            </div>


            <!-- Active Status -->
            <div class="toggle-wrapper">

                <input asp-for="IsActive" />

                <label asp-for="IsActive">
                    Active Category
                </label>

            </div>


            <!-- Buttons -->
            <div class="form-actions">

                <button type="submit"
                        class="btn-save-category">
                    Save Category
                </button>

                <a asp-action="Index"
                   class="btn-cancel-category">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        const categoryImage = document.getElementById("categoryImage");
        const imagePreview = document.getElementById("imagePreview");
        const imagePreviewWrapper =
            document.getElementById("imagePreviewWrapper");

        categoryImage.addEventListener("change", function () {

            const file = this.files[0];

            if (!file) {
                imagePreviewWrapper.style.display = "none";
                imagePreview.removeAttribute("src");
                return;
            }

            const allowedTypes = [
                "image/jpeg",
                "image/png",
                "image/webp"
            ];

            if (!allowedTypes.includes(file.type)) {
                alert("Please select a JPG, JPEG, PNG or WebP image.");

                this.value = "";
                imagePreviewWrapper.style.display = "none";
                imagePreview.removeAttribute("src");

                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                alert("Image size must be less than 5 MB.");

                this.value = "";
                imagePreviewWrapper.style.display = "none";
                imagePreview.removeAttribute("src");

                return;
            }

            const reader = new FileReader();

            reader.onload = function (event) {

                imagePreview.src = event.target.result;
                imagePreviewWrapper.style.display = "block";

            };

            reader.readAsDataURL(file);

        });

    </script>
}