@model IEnumerable<ShopSphere.Models.Category>
@using ShopSphere.Helpers
@{
    ViewData["Title"] = "Categories";
    var categoryCount = Model?.Count() ?? 0;
}

<style>
    
    /* =========================
           PAGE HEADER
        ========================== */

    .categories-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
        flex-wrap: wrap;
    }

    .categories-title h1 {
        font-size: 42px;
        font-weight: 800;
        color: #1f2937;
        margin-bottom: 8px;
    }

    .categories-title p {
        color: #64748b;
        font-size: 17px;
        margin: 0;
    }

    .btn-add-category {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: white;
        border: none;
        padding: 14px 24px;
        border-radius: 12px;
        font-size: 17px;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 8px 20px rgba(37, 99, 235, .25);
        transition: all .25s ease;
    }

        .btn-add-category:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(37, 99, 235, .35);
        }


    /* =========================
           MAIN CARD
        ========================== */

    .category-main-card {
        background: white;
        border-radius: 20px;
        padding: 26px;
        box-shadow: 0 8px 30px rgba(15, 23, 42, .08);
        border: 1px solid #eef2f7;
    }

    .category-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
        flex-wrap: wrap;
    }

        .category-card-top h3 {
            font-weight: 700;
            color: #1f2937;
            margin: 0 0 5px 0;
        }

    .category-count {
        color: #64748b;
        margin: 0;
        font-size: 15px;
    }


    /* =========================
           SEARCH
        ========================== */

    .search-box {
        position: relative;
        width: 280px;
    }

        .search-box span {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 18px;
        }

        .search-box input {
            width: 100%;
            padding: 12px 15px 12px 45px;
            border: 1px solid #dbe3ef;
            border-radius: 12px;
            outline: none;
            font-size: 15px;
            transition: .2s;
        }

            .search-box input:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 4px rgba(37, 99, 235, .10);
            }
/* =========================
       CATEGORY IMAGE
    ========================== */

.category-image-wrapper {
    width: 70px;
    height: 55px;
    border-radius: 10px;
    overflow: hidden;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
}

.category-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.category-image-placeholder {
    font-size: 25px;
    color: #94a3b8;
}

    /* =========================
           TABLE
        ========================== */

    .category-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

        .category-table thead th {
            background: #f8fafc;
            color: #475569;
            font-size: 14px;
            font-weight: 700;
            padding: 16px;
            border-bottom: 1px solid #e5e7eb;
            white-space: nowrap;
        }

        .category-table tbody td {
            padding: 17px 16px;
            color: #334155;
            border-bottom: 1px solid #eef2f7;
            vertical-align: middle;
        }

        .category-table tbody tr {
            transition: .2s;
        }

            .category-table tbody tr:hover {
                background: #f8fbff;
            }


    .category-id {
        color: #94a3b8;
        font-weight: 600;
    }

    .category-name {
        font-weight: 700;
        color: #1e293b;
    }


    /* =========================
           STATUS
        ========================== */

    .status-active {
        display: inline-block;
        padding: 7px 12px;
        border-radius: 20px;
        background: #dcfce7;
        color: #15803d;
        font-size: 13px;
        font-weight: 700;
    }

    .status-inactive {
        display: inline-block;
        padding: 7px 12px;
        border-radius: 20px;
        background: #fee2e2;
        color: #dc2626;
        font-size: 13px;
        font-weight: 700;
    }


    /* =========================
           ACTION BUTTONS
        ========================== */

    .btn-edit-category {
        display: inline-block;
        padding: 8px 14px;
        border-radius: 8px;
        background: #eff6ff;
        color: #2563eb;
        text-decoration: none;
        font-weight: 600;
        margin-right: 5px;
        transition: .2s;
        border: none;
    }

        .btn-edit-category:hover {
            background: #2563eb;
            color: white;
        }


    .btn-delete-category {
        display: inline-block;
        padding: 8px 14px;
        border-radius: 8px;
        background: #fef2f2;
        color: #dc2626;
        text-decoration: none;
        font-weight: 600;
        transition: .2s;
        border: none;
        cursor: pointer;
    }

        .btn-delete-category:hover {
            background: #dc2626;
            color: white;
        }


    /* =========================
           EMPTY STATE
        ========================== */

    .empty-category {
        text-align: center;
        padding: 75px 20px;
    }

    .empty-icon {
        font-size: 65px;
        margin-bottom: 15px;
    }

    .empty-category h3 {
        font-weight: 750;
        color: #1f2937;
        margin-bottom: 10px;
    }

    .empty-category p {
        color: #64748b;
        font-size: 16px;
        margin-bottom: 25px;
    }

    .btn-first-category {
        display: inline-block;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: white;
        text-decoration: none;
        padding: 13px 22px;
        border-radius: 10px;
        font-weight: 600;
        transition: .2s;
    }

        .btn-first-category:hover {
            color: white;
            transform: translateY(-2px);
        }


    /* =========================
           DELETE MODAL
        ========================== */

    .delete-modal-content {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(15, 23, 42, .20);
    }

    .delete-modal-body {
        padding: 35px;
        text-align: center;
    }

    .delete-warning-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: #fef2f2;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 38px;
    }

    .delete-modal-title {
        color: #1f2937;
        font-size: 26px;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .delete-modal-text {
        color: #64748b;
        font-size: 16px;
        line-height: 1.7;
        margin-bottom: 8px;
    }

    .delete-category-name {
        color: #dc2626;
        font-weight: 800;
        font-size: 17px;
        margin-bottom: 25px;
    }

    .btn-cancel-delete {
        padding: 11px 22px;
        border-radius: 10px;
        border: 1px solid #dbe3ef;
        background: white;
        color: #475569;
        font-weight: 600;
        transition: .2s;
    }

        .btn-cancel-delete:hover {
            background: #f8fafc;
        }

    .btn-confirm-delete {
        padding: 11px 22px;
        border-radius: 10px;
        border: none;
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: white;
        font-weight: 700;
        box-shadow: 0 8px 20px rgba(220, 38, 38, .20);
        transition: .2s;
    }

        .btn-confirm-delete:hover {
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 10px 25px rgba(220, 38, 38, .30);
        }


    /* =========================
           RESPONSIVE
        ========================== */

    @@media (max-width: 768px) {

        .categories-title h1 {
            font-size: 32px;
        }

        .search-box {
            width: 100%;
        }

        .category-table {
            min-width: 850px;
        }

        .table-responsive {
            overflow-x: auto;
        }
    }

</style>


<!-- =========================
     PAGE HEADER
========================= -->

<div class="categories-page-header">

    <div class="categories-title">
        <h1>Categories 📁</h1>
        <p>Manage all your marketplace product categories from one place.</p>
    </div>

    <a asp-action="Create" class="btn-add-category">
        + Add New Category
    </a>

</div>


<!-- =========================
     MAIN CATEGORY CARD
========================= -->

<div class="category-main-card">

    <div class="category-card-top">

        <div>
            <h3>All Categories</h3>

            <p class="category-count">
                Total: @categoryCount categories
            </p>
        </div>

        <form asp-action="Index"
              asp-controller="Categories"
              asp-area="Admin"
              method="get"
              style="display: flex; align-items: center; gap: 12px;">

            
            <div class="status-filter">
                <select name="status" onchange="this.form.submit()">
                    <option value="">All Status</option>
                    <option value="Active"
                            selected="@(ViewBag.Status == "Active")">
                        Active
                    </option>
                    <option value="Inactive"
                            selected="@(ViewBag.Status == "Inactive")">
                        Inactive
                    </option>
                </select>
            </div>

            <!-- SEARCH -->
            <div class="search-box">
                <span>🔎</span>

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       placeholder="Search categories..." />
            </div>

        </form>

    </div>


    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">

            <table class="category-table" id="categoryTable">

                <thead>
                    <tr>
                       <th>#</th>
<th>Image</th>
<th>Category Name</th>
<th>Description</th>
<th>Status</th>
<th>Created Date</th>
<th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @{
                        int serial = 1;
                    }

                    @foreach (var category in Model)
                    {
                        <tr>

                            <td class="category-id">
                                #@serial
                            </td>
<td>
    <div class="category-image-wrapper">

        @if (!string.IsNullOrWhiteSpace(category.ImageUrl))
        {
            <img src="@category.ImageUrl"
                 alt="@category.Name"
                 loading="lazy" />
        }
        else
        {
            <span class="category-image-placeholder">
                📁
            </span>
        }

    </div>
</td>
                            <td class="category-name">
                                📁 @category.Name
                            </td>

                            <td>
                                @(string.IsNullOrEmpty(category.Description)
                                    ? "No description"
                                    : category.Description)
                            </td>

                            <td>

                                @if (category.IsActive)
                                {
                                    <span class="status-active">
                                        ● Active
                                    </span>
                                }
                                else
                                {
                                    <span class="status-inactive">
                                        ● Inactive
                                    </span>
                                }

                            </td>

                            <td>
                                @BangladeshTimeHelper.ToBangladeshTime(category.CreatedAt).ToString("dd MMM yyyy")
                            </td>

                            <td class="text-center">

                                <a asp-action="Edit"
                                   asp-route-id="@category.Id"
                                   class="btn-edit-category">
                                    ✏️ Edit
                                </a>


                                <!-- DELETE MODAL BUTTON -->

                                <button type="button"
                                        class="btn-delete-category delete-category-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteCategoryModal"
                                        data-category-id="@category.Id"
                                        data-category-name="@category.Name">
                                    🗑 Delete
                                </button>

                            </td>

                        </tr>

                        serial++;
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="empty-category">

            <div class="empty-icon">
                📁
            </div>

            <h3>No categories found</h3>

            <p>
                Start organizing your marketplace by creating your first category.
            </p>

            <a asp-action="Create" class="btn-first-category">
                + Add First Category
            </a>

        </div>
    }

</div>


<!-- =========================
     DELETE CONFIRMATION MODAL
========================= -->

<div class="modal fade"
     id="deleteCategoryModal"
     tabindex="-1"
     aria-labelledby="deleteCategoryModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content delete-modal-content">

            <form asp-action="Delete"
                  asp-controller="Categories"
                  asp-area="Admin"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="deleteCategoryId"
                       name="id" />

                <div class="delete-modal-body">

                    <div class="delete-warning-icon">
                        🗑️
                    </div>

                    <h3 class="delete-modal-title"
                        id="deleteCategoryModalLabel">
                        Delete Category?
                    </h3>

                    <p class="delete-modal-text">
                        Are you sure you want to delete this category?
                        This action cannot be undone.
                    </p>

                    <p class="delete-category-name"
                       id="deleteCategoryName">
                    </p>

                    <div class="d-flex justify-content-center gap-2 flex-wrap">

                        <button type="button"
                                class="btn-cancel-delete"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn-confirm-delete">
                            🗑 Yes, Delete Category
                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        // =========================
        // CATEGORY SEARCH
        // =========================

        document.getElementById("categorySearch")
            ?.addEventListener("keyup", function() {

                let searchValue = this.value.toLowerCase();

                let rows =
                    document.querySelectorAll("#categoryTable tbody tr");

                rows.forEach(function(row) {

                    let text = row.innerText.toLowerCase();

                    row.style.display =
                        text.includes(searchValue) ? "" : "none";

                });

            });


        // =========================
        // DELETE CATEGORY MODAL
        // =========================

        const deleteButtons =
            document.querySelectorAll(".delete-category-btn");

        const deleteCategoryId =
            document.getElementById("deleteCategoryId");

        const deleteCategoryName =
            document.getElementById("deleteCategoryName");


        deleteButtons.forEach(function(button) {

            button.addEventListener("click", function() {

                const categoryId =
                    this.getAttribute("data-category-id");

                const categoryName =
                    this.getAttribute("data-category-name");


                deleteCategoryId.value = categoryId;

                deleteCategoryName.textContent =
                    "📁 " + categoryName;

            });

        });

    </script>

}