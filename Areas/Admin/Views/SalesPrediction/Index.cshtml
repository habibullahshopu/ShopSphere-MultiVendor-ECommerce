@model ShopSphere.Services.SalesPredictionResult?

@{
    ViewData["Title"] = "AI Sales Prediction";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">

        <div>
            <h1 class="fw-bold mb-1">
                🤖 AI Sales Prediction
            </h1>

            <p class="text-muted mb-0">
                AI-powered sales forecast based on recent ShopSphere sales data.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Back to Dashboard
        </a>

    </div>


    <!-- ==========================================
         MESSAGE
    =========================================== -->
    @if (ViewBag.Message != null)
    {
        <div class="alert alert-warning border-0 shadow-sm rounded-4">
            ⚠️ @ViewBag.Message
        </div>
    }


    <!-- ==========================================
         AI PREDICTION RESULT
    =========================================== -->
    @if (Model != null)
    {
        <div class="row g-4 mb-4">

            <!-- Predicted Sales -->
            <div class="col-lg-4 col-md-6">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-body p-4">

                        <div class="text-muted mb-2">
                            Predicted Sales
                        </div>

                        <h2 class="fw-bold text-primary mb-0">
                            ৳ @Model.PredictedSales.ToString("N2")
                        </h2>

                    </div>

                </div>

            </div>


            <!-- Predicted Orders -->
            <div class="col-lg-4 col-md-6">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-body p-4">

                        <div class="text-muted mb-2">
                            Predicted Orders
                        </div>

                        <h2 class="fw-bold mb-0">
                            @Model.PredictedOrders
                        </h2>

                    </div>

                </div>

            </div>


            <!-- Predicted Items -->
            <div class="col-lg-4 col-md-6">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-body p-4">

                        <div class="text-muted mb-2">
                            Predicted Items Sold
                        </div>

                        <h2 class="fw-bold mb-0">
                            @Model.PredictedItemsSold
                        </h2>

                    </div>

                </div>

            </div>

        </div>


        <!-- ==========================================
             TREND + EXPLANATION
        =========================================== -->

        <div class="row g-4 mb-4">

            <!-- Trend -->
            <div class="col-lg-4">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-body p-4">

                        <h5 class="fw-bold mb-3">
                            📈 Sales Trend
                        </h5>

                        <span class="badge bg-primary fs-6 px-3 py-2">
                            @Model.Trend
                        </span>

                    </div>

                </div>

            </div>


            <!-- Explanation -->
            <div class="col-lg-8">

                <div class="card border-0 shadow-sm rounded-4 h-100">

                    <div class="card-body p-4">

                        <h5 class="fw-bold mb-3">
                            💡 AI Explanation
                        </h5>

                        <p class="text-muted mb-0">
                            @Model.Explanation
                        </p>

                    </div>

                </div>

            </div>

        </div>
    }
    else if (ViewBag.Message == null)
    {
        <!-- ==========================================
             READY TO GENERATE
        =========================================== -->

        <div class="card border-0 shadow-sm rounded-4 mb-4">

            <div class="card-body p-5 text-center">

                <div class="mb-3" style="font-size: 3rem;">
                    🤖
                </div>

                <h3 class="fw-bold mb-2">
                    AI Prediction Ready
                </h3>

                <p class="text-muted mb-4">
                    Historical sales data is available.
                    Click the button below to generate an
                    AI-powered sales prediction.
                </p>

                <form asp-area="Admin"
                      asp-controller="SalesPrediction"
                      asp-action="Generate"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-primary btn-lg px-4">

                        🤖 Generate AI Prediction

                    </button>

                </form>

            </div>

        </div>
    }


    <!-- ==========================================
         SALES TREND
    =========================================== -->
    @if (ViewBag.SalesHistory != null)
    {
        var salesHistory =
            ViewBag.SalesHistory
            as List<ShopSphere.Services.SalesHistoryItem>;

        if (salesHistory != null && salesHistory.Count > 0)
        {
            var maxSales =
                salesHistory.Max(x => x.SalesAmount);

            <div class="card border-0 shadow-sm rounded-4 mb-4">

                <div class="card-body p-4">

                    <div class="mb-4">

                        <h5 class="fw-bold mb-1">
                            📈 Sales Trend
                        </h5>

                        <p class="text-muted mb-0">
                            Daily sales performance from the available
                            historical data.
                        </p>

                    </div>


                    <div class="d-flex flex-column gap-3">

                        @foreach (var item in salesHistory)
                        {
                            var percentage = maxSales > 0
                                ? (item.SalesAmount / maxSales) * 100
                                : 0;

                            <div>

                                <div class="d-flex justify-content-between
                                    align-items-center mb-1">

                                    <small class="text-muted">
                                        @item.Date.ToString("dd MMM")
                                    </small>

                                    <small class="fw-semibold">
                                        ৳ @item.SalesAmount.ToString("N2")
                                    </small>

                                </div>


                                <div class="progress"
                                     style="height: 10px;">

                                    <div class="progress-bar"
                                         role="progressbar"
                                         style="width: @percentage.ToString("0.##")%;">
                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>
        }
    }


    <!-- ==========================================
         HISTORICAL SALES DATA
    =========================================== -->
    @if (ViewBag.SalesHistory != null)
    {
        var salesHistory =
            ViewBag.SalesHistory
            as List<ShopSphere.Services.SalesHistoryItem>;

        if (salesHistory != null && salesHistory.Count > 0)
        {
            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between
                        align-items-center
                        flex-wrap gap-2 mb-4">

                        <div>

                            <h5 class="fw-bold mb-1">
                                📊 Historical Sales Data
                            </h5>

                            <p class="text-muted mb-0">
                                Sales data used by the AI prediction system.
                            </p>

                        </div>


                        <span class="badge bg-light text-dark
                            border px-3 py-2">

                            Last 30 Days

                        </span>

                    </div>


                    <div class="table-responsive">

                        <table class="table align-middle mb-0">

                            <thead>

                                <tr>

                                    <th>
                                        Date
                                    </th>

                                    <th>
                                        Sales Amount
                                    </th>

                                    <th>
                                        Orders
                                    </th>

                                    <th>
                                        Items Sold
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var item in salesHistory)
                                {
                                    <tr>

                                        <td>
                                            @item.Date.ToString("dd MMM yyyy")
                                        </td>

                                        <td class="fw-semibold">
                                            ৳ @item.SalesAmount.ToString("N2")
                                        </td>

                                        <td>
                                            @item.OrderCount
                                        </td>

                                        <td>
                                            @item.ItemsSold
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>
        }
    }

</div>
<script>
    document.addEventListener("DOMContentLoaded", function() {

        const forms = document.querySelectorAll(
            'form[action*="SalesPrediction"][action*="Generate"]'
        );

        forms.forEach(function(form) {

            form.addEventListener("submit", function() {

                const button = form.querySelector(
                    'button[type="submit"]'
                );

                if (!button) {
                    return;
                }

                button.disabled = true;

                button.innerHTML =
                    "⏳ Generating AI Prediction...";

            });

        });

    });
</script>