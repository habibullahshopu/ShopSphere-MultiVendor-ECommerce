@model IEnumerable<ShopSphere.Models.SupportTicket>

@{
    ViewData["Title"] = "Support Tickets";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">🎧 Support Tickets</h2>
            <p class="text-muted mb-0">
                Manage customer support requests and messages.
            </p>
        </div>

        <span class="badge bg-primary fs-6 px-3 py-2">
            @Model.Count() Tickets
        </span>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center py-5">
                <div style="font-size: 50px;">📭</div>

                <h5 class="fw-bold mt-3">
                    No Support Tickets
                </h5>

                <p class="text-muted mb-0">
                    There are currently no customer support requests.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="px-4">#</th>
                                <th>Customer</th>
                                <th>Email</th>
                                <th>Subject</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th class="text-end px-4">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var ticket in Model)
                            {
                                var statusClass = ticket.Status switch
                                {
                                    "Open" => "bg-warning text-dark",
                                    "In Progress" => "bg-info text-dark",
                                    "Resolved" => "bg-success",
                                    "Closed" => "bg-secondary",
                                    _ => "bg-secondary"
                                };

                                <tr>

                                    <td class="px-4 fw-semibold">
                                        #@ticket.Id
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @ticket.Name
                                        </div>
                                    </td>

                                    <td>
                                        <span class="text-muted">
                                            @ticket.Email
                                        </span>
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @ticket.Subject
                                        </div>

                                        <small class="text-muted">
                                            @(ticket.Message.Length > 70
                                                ? ticket.Message.Substring(0, 70) + "..."
                                                : ticket.Message)
                                        </small>
                                    </td>

                                    <td>
                                        <span class="badge @statusClass px-3 py-2">
                                            @ticket.Status
                                        </span>
                                    </td>

                                    <td>
                                        <span class="text-muted">
                                            @ticket.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                        </span>

                                        <small class="d-block text-muted">
                                            @ticket.CreatedAt.ToLocalTime().ToString("hh:mm tt")
                                        </small>
                                    </td>

                                    <td class="text-end px-4">
                                        <a asp-area="Admin"
                                           asp-controller="Support"
                                           asp-action="Details"
                                           asp-route-id="@ticket.Id"
                                           class="btn btn-sm btn-primary rounded-3 px-3">
                                            👁 View
                                        </a>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>