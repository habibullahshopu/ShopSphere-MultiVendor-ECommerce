@model ShopSphere.Models.SupportTicket

@{
    ViewData["Title"] = "Support Ticket Details";

    var statusClass = Model.Status switch
    {
        "Open" => "bg-warning text-dark",
        "In Progress" => "bg-info text-dark",
        "Resolved" => "bg-success",
        "Closed" => "bg-secondary",
        _ => "bg-secondary"
    };
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">🎧 Support Ticket #@Model.Id</h2>
            <p class="text-muted mb-0">
                View customer support request details.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Support"
           asp-action="Index"
           class="btn btn-outline-secondary rounded-3">
            ← Back to Tickets
        </a>
    </div>

    <div class="row g-4">

        <!-- Customer Information -->
        <div class="col-lg-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-4">
                        👤 Customer Information
                    </h5>

                    <div class="mb-3">
                        <small class="text-muted d-block">
                            Name
                        </small>

                        <div class="fw-semibold">
                            @Model.Name
                        </div>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted d-block">
                            Email
                        </small>

                        <div class="fw-semibold">
                            @Model.Email
                        </div>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted d-block">
                            Submitted
                        </small>

                        <div class="fw-semibold">
                            @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                        </div>
                    </div>

                    <div>
                        <small class="text-muted d-block mb-1">
                            Status
                        </small>

                        <span class="badge @statusClass px-3 py-2">
                            @Model.Status
                        </span>
                    </div>

                </div>

            </div>

        </div>

        <!-- Ticket Message & Reply -->
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4">

                    <!-- Customer Message -->
                    <h5 class="fw-bold mb-1">
                        💬 @Model.Subject
                    </h5>

                    <p class="text-muted small mb-4">
                        Customer's support message
                    </p>

                    <div class="bg-light rounded-3 p-4">
                        <p class="mb-0" style="white-space: pre-line;">
                            @Model.Message
                        </p>
                    </div>

                    <!-- Admin Reply Form -->
                    <hr class="my-4" />

                    <h6 class="fw-bold mb-3">
                        📩 Reply to Customer
                    </h6>

                    <form asp-area="Admin"
                          asp-controller="Support"
                          asp-action="Reply"
                          method="post">

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Admin Reply
                            </label>

                            <textarea name="reply"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Write your reply to the customer..."
                                      required>@Model.AdminReply</textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Ticket Status
                            </label>

                            <select name="status"
                                    class="form-select">

                                <option value="Open"
                                        selected="@(Model.Status == "Open")">
                                    Open
                                </option>

                                <option value="In Progress"
                                        selected="@(Model.Status == "In Progress")">
                                    In Progress
                                </option>

                                <option value="Resolved"
                                        selected="@(Model.Status == "Resolved")">
                                    Resolved
                                </option>

                                <option value="Closed"
                                        selected="@(Model.Status == "Closed")">
                                    Closed
                                </option>

                            </select>
                        </div>

                        <button type="submit"
                                class="btn btn-primary rounded-3 px-4">
                            📤 Send Reply
                        </button>

                    </form>

                    <!-- Existing Admin Reply -->
                    @if (!string.IsNullOrWhiteSpace(Model.AdminReply))
                    {
                        <hr class="my-4" />

                        <h6 class="fw-bold mb-3">
                            📩 Admin Reply
                        </h6>

                        <div class="alert alert-success rounded-3 mb-0">
                            <div style="white-space: pre-line;">
                                @Model.AdminReply
                            </div>
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>