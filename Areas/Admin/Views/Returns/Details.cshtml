@model ShopSphere.Models.ReturnRequest

@{
    ViewData["Title"] = $"Return Request #{Model.Id}";

    string statusClass = Model.Status switch
    {
        "Pending" => "bg-warning text-dark",
        "Approved" => "bg-primary",
        "Rejected" => "bg-danger",
        "Completed" => "bg-success",
        _ => "bg-secondary"
    };

    string refundStatusClass = Model.RefundStatus switch
    {
        "Completed" => "bg-success",
        "Rejected" => "bg-danger",
        "Pending" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-arrow-return-left me-2"></i>
                Return Request #@Model.Id
            </h2>

            <p class="text-muted mb-0">
                Submitted on @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Returns"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Returns
        </a>

    </div>


    <div class="row g-4">

        <!-- LEFT -->
        <div class="col-lg-8">

            <!-- Request Information -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <h5 class="fw-bold mb-0">
                            Request Information
                        </h5>

                        <span class="badge @statusClass px-3 py-2">
                            @Model.Status
                        </span>

                    </div>


                    <div class="row g-4">

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Return Request ID
                            </small>

                            <strong>
                                #@Model.Id
                            </strong>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Order ID
                            </small>

                            <strong>
                                #@(Model.Order?.Id ?? Model.OrderId)
                            </strong>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Reason
                            </small>

                            <strong>
                                @Model.Reason
                            </strong>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Submitted
                            </small>

                            <strong>
                                @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                            </strong>

                        </div>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <hr class="my-4" />

                        <small class="text-muted d-block mb-2">
                            Customer Description
                        </small>

                        <div class="bg-light rounded-3 p-3">
                            @Model.Description
                        </div>
                    }

                </div>

            </div>


            <!-- Customer Information -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-4">
                        <i class="bi bi-person me-2"></i>
                        Customer Information
                    </h5>

                    <div class="row g-4">

                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Name
                            </small>

                            <strong>
                                @(Model.User?.FullName ?? "N/A")
                            </strong>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted d-block">
                                Email
                            </small>

                            <strong>
                                @(Model.User?.Email ?? "N/A")
                            </strong>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Order Information -->
            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-4">
                        <i class="bi bi-box-seam me-2"></i>
                        Order Information
                    </h5>


                    @if (Model.Order != null)
                    {
                        <div class="table-responsive">

                            <table class="table align-middle mb-0">

                                <thead class="table-light">

                                    <tr>
                                        <th>Product</th>
                                        <th>Quantity</th>
                                        <th>Unit Price</th>
                                        <th class="text-end">Subtotal</th>
                                    </tr>

                                </thead>


                                <tbody>

                                    @foreach (var item in Model.Order.OrderItems)
                                    {
                                        <tr>

                                            <td>
                                                <div class="fw-semibold">
                                                    @item.ProductName
                                                </div>
                                            </td>

                                            <td>
                                                @item.Quantity
                                            </td>

                                            <td>
                                                ৳ @item.UnitPrice.ToString("N2")
                                            </td>

                                            <td class="text-end fw-semibold">
                                                ৳ @item.Subtotal.ToString("N2")
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>


                        <hr />


                        <div class="d-flex justify-content-between">

                            <span class="fw-bold">
                                Order Total
                            </span>

                            <span class="fw-bold fs-5 text-primary">
                                ৳ @Model.Order.TotalAmount.ToString("N2")
                            </span>

                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            Order information is unavailable.
                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- RIGHT -->
        <div class="col-lg-4">

            <!-- Refund Summary -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-4">
                        <i class="bi bi-cash-stack me-2"></i>
                        Refund Summary
                    </h5>


                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Refund Amount
                        </span>

                        <strong class="fs-5">
                            ৳ @Model.RefundAmount.ToString("N2")
                        </strong>

                    </div>


                    <div class="d-flex justify-content-between">

                        <span class="text-muted">
                            Refund Status
                        </span>

                        <span class="badge @refundStatusClass">
                            @(Model.RefundStatus ?? "Pending")
                        </span>

                    </div>

                </div>

            </div>


            <!-- Admin Note -->
            @if (!string.IsNullOrWhiteSpace(Model.AdminNote))
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4">

                    <div class="card-body p-4">

                        <h5 class="fw-bold mb-3">
                            <i class="bi bi-chat-left-text me-2"></i>
                            Admin Note
                        </h5>

                        <div class="bg-light rounded-3 p-3 small">
                            @Model.AdminNote
                        </div>

                    </div>

                </div>
            }


            <!-- Actions -->
            @if (Model.Status == "Pending")
            {
                <div class="card border-0 shadow-sm rounded-4">

                    <div class="card-body p-4">

                        <h5 class="fw-bold mb-4">
                            Manage Request
                        </h5>


                        <!-- Approve -->
                        <form asp-area="Admin"
                              asp-controller="Returns"
                              asp-action="Approve"
                              method="post"
                              class="mb-3">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.Id" />

                            <div class="mb-3">

                                <label class="form-label fw-semibold">
                                    Refund Amount
                                </label>

                                <input type="number"
                                       name="refundAmount"
                                       value="@Model.RefundAmount"
                                       min="0"
                                       max="@(Model.Order?.TotalAmount ?? Model.RefundAmount)"
                                       step="0.01"
                                       class="form-control"
                                       required />

                            </div>


                            <div class="mb-3">

                                <label class="form-label fw-semibold">
                                    Admin Note
                                </label>

                                <textarea name="adminNote"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Optional note for the customer"></textarea>

                            </div>


                            <button type="submit"
                                    class="btn btn-primary w-100">

                                <i class="bi bi-check-circle me-1"></i>
                                Approve Return

                            </button>

                        </form>


                        <!-- Reject -->
                        <form asp-area="Admin"
                              asp-controller="Returns"
                              asp-action="Reject"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.Id" />

                            <div class="mb-3">

                                <label class="form-label fw-semibold">
                                    Rejection Note
                                </label>

                                <textarea name="adminNote"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Reason for rejecting this request"></textarea>

                            </div>


                            <button type="submit"
                                    class="btn btn-outline-danger w-100">

                                <i class="bi bi-x-circle me-1"></i>
                                Reject Return

                            </button>

                        </form>

                    </div>

                </div>
            }


            <!-- Complete Refund -->
            @if (Model.Status == "Approved" &&
                 Model.RefundStatus == "Pending")
            {
                <div class="card border-0 shadow-sm rounded-4">

                    <div class="card-body p-4">

                        <h5 class="fw-bold mb-2">
                            Complete Refund
                        </h5>

                        <p class="text-muted small">
                            After the refund has actually been processed,
                            mark this request as completed.
                        </p>


                        <form asp-area="Admin"
                              asp-controller="Returns"
                              asp-action="CompleteRefund"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-success w-100">

                                <i class="bi bi-check2-circle me-1"></i>
                                Mark Refund Completed

                            </button>

                        </form>

                    </div>

                </div>
            }

        </div>

    </div>

</div>