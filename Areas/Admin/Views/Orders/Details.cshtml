@model ShopSphere.Models.Order

@using ShopSphere.Helpers

@{
    ViewData["Title"] = $"Order #{Model.Id}";

    var payment = ViewBag.Payment as ShopSphere.Models.Payment;

    // Bangladesh Time
    string createdAtText =
        BangladeshTimeHelper
            .ToBangladeshTime(Model.CreatedAt)
            .ToString("dd MMM yyyy, hh:mm tt");

    string paidAtText = "Not paid yet";

    if (payment != null && payment.PaidAt.HasValue)
    {
        paidAtText =
            BangladeshTimeHelper
                .ToBangladeshTime(payment.PaidAt.Value)
                .ToString("dd MMM yyyy, hh:mm tt");
    }

    string paymentCreatedAtText = "N/A";

    if (payment != null)
    {
        paymentCreatedAtText =
            BangladeshTimeHelper
                .ToBangladeshTime(payment.CreatedAt)
                .ToString("dd MMM yyyy, hh:mm tt");
    }

    var orderStatusClass = Model.Status switch
    {
        "Pending" => "bg-warning text-dark",
        "Processing" => "bg-info text-dark",
        "Shipped" => "bg-primary",
        "Delivered" => "bg-success",
        "Cancelled" => "bg-danger",
        "Refunded" => "bg-success",
        _ => "bg-secondary"
    };

    var paymentStatusClass = Model.PaymentStatus switch
    {
        "Pending" => "bg-warning text-dark",
        "Paid" => "bg-success",
        "Failed" => "bg-danger",
        "Refunded" => "bg-success",
        _ => "bg-secondary"
    };
}

<div class="container-fluid py-4">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Order #@Model.Id 📦
            </h1>

            <div class="text-muted">
                Created on @createdAtText
            </div>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            ← Back to Orders
        </a>

    </div>


    <div class="row g-4">

        <!-- ===================================================== -->
        <!-- LEFT COLUMN -->
        <!-- ===================================================== -->

        <div class="col-lg-8">

            <!-- ================================================= -->
            <!-- CUSTOMER INFORMATION -->
            <!-- ================================================= -->

            <div class="card border-0 shadow-sm rounded-4 mb-4">

                <div class="card-body p-4">

                    <h4 class="fw-bold mb-4">
                        Customer Information
                    </h4>

                    <div class="row g-4">

                        <div class="col-md-6">

                            <small class="text-muted d-block mb-1">
                                Customer Name
                            </small>

                            <div class="fw-semibold">
                                @Model.CustomerName
                            </div>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted d-block mb-1">
                                Email
                            </small>

                            <div class="fw-semibold text-break">
                                @Model.CustomerEmail
                            </div>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted d-block mb-1">
                                City
                            </small>

                            <div class="fw-semibold">
                                @Model.City
                            </div>

                        </div>


                        <div class="col-md-6">

                            <small class="text-muted d-block mb-1">
                                Postal Code
                            </small>

                            <div class="fw-semibold">
                                @Model.PostalCode
                            </div>

                        </div>


                        <div class="col-12">

                            <small class="text-muted d-block mb-1">
                                Shipping Address
                            </small>

                            <div class="fw-semibold">
                                @Model.ShippingAddress
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- ORDER ITEMS -->
            <!-- ================================================= -->

            <div class="card border-0 shadow-sm rounded-4 mb-4">

                <div class="card-body p-4">

                    <h4 class="fw-bold mb-4">
                        Order Items
                    </h4>

                    @foreach (var item in Model.OrderItems)
                    {
                        <div class="d-flex align-items-center border-bottom py-3">

                            <div class="me-3">

                                @if (!string.IsNullOrWhiteSpace(item.Product?.ImageUrl))
                                {
                                    <img src="@item.Product.ImageUrl"
                                         alt="@item.Product.Name"
                                         class="rounded-3 border"
                                         style="width:60px;height:60px;object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center bg-light border rounded-3"
                                         style="width:60px;height:60px;font-size:28px;">
                                        📦
                                    </div>
                                }

                            </div>


                            <div class="flex-grow-1">

                                <div class="fw-bold">
                                    @item.Product?.Name
                                </div>

                                <div class="text-muted small">
                                    Qty: @item.Quantity
                                    ×
                                    ৳ @item.UnitPrice.ToString("N2")
                                </div>

                            </div>


                            <div class="fw-bold">
                                ৳ @((item.Quantity * item.UnitPrice).ToString("N2"))
                            </div>

                        </div>
                    }

                </div>

            </div>


            <!-- ================================================= -->
            <!-- PAYMENT DETAILS -->
            <!-- ================================================= -->
            @if (payment != null)
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4">

                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-center mb-4">

                            <div>
                                <h4 class="fw-bold mb-1">
                                    Payment Details 💳
                                </h4>

                                <div class="text-muted small">
                                    SSLCOMMERZ payment information
                                </div>
                            </div>


                            <span class="badge @paymentStatusClass px-3 py-2">
                                @payment.Status
                            </span>

                        </div>


                        <div class="row g-4">

                            <!-- Transaction ID -->
                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    Transaction ID
                                </small>

                                <div class="fw-semibold text-break">
                                    @(string.IsNullOrWhiteSpace(payment.TranId)
                                        ? "N/A"
                                        : payment.TranId)
                                </div>

                            </div>


                            <!-- Validation ID -->
                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    Validation ID
                                </small>

                                <div class="fw-semibold text-break">
                                    @(string.IsNullOrWhiteSpace(payment.ValId)
                                        ? "N/A"
                                        : payment.ValId)
                                </div>

                            </div>


                            <!-- Bank Transaction ID -->
                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    Bank Transaction ID
                                </small>

                                <div class="fw-semibold text-break">
                                    @(string.IsNullOrWhiteSpace(payment.BankTranId)
                                        ? "N/A"
                                        : payment.BankTranId)
                                </div>

                            </div>


                            <!-- Card Type -->
                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    Card Type
                                </small>

                                <div class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(payment.CardType)
                                        ? "N/A"
                                        : payment.CardType)
                                </div>

                            </div>


                            <!-- Amount -->
                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    Payment Amount
                                </small>

                                <div class="fw-bold text-success">
                                    ৳ @payment.Amount.ToString("N2")
                                </div>

                            </div>


                            <!-- Currency -->
                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    Currency
                                </small>

                                <div class="fw-semibold">
                                    @payment.Currency
                                </div>

                            </div>


                            <!-- Gateway Status -->
                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    Gateway Status
                                </small>

                                <div class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(payment.GatewayStatus)
                                        ? "N/A"
                                        : payment.GatewayStatus)
                                </div>

                            </div>


                            <!-- Session Key -->
                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    Session Key
                                </small>

                                <div class="fw-semibold text-break small">
                                    @(string.IsNullOrWhiteSpace(payment.SessionKey)
                                        ? "N/A"
                                        : payment.SessionKey)
                                </div>

                            </div>


                            <!-- Paid At -->
                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    Paid At
                                </small>

                                <div class="fw-semibold">
                                    @paidAtText
                                </div>

                            </div>


                            <!-- Payment Created -->
                            <div class="col-md-6">

                                <small class="text-muted d-block mb-1">
                                    Payment Created
                                </small>

                                <div class="fw-semibold">
                                    @paymentCreatedAtText
                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }
            else
            {
                <div class="alert alert-warning shadow-sm">
                    <strong>Payment information not found.</strong>
                    No payment record exists for this order.
                </div>
            }

        </div>


        <!-- ===================================================== -->
        <!-- RIGHT COLUMN -->
        <!-- ===================================================== -->

        <div class="col-lg-4">


            <!-- ================================================= -->
            <!-- ORDER SUMMARY -->
            <!-- ================================================= -->

            <div class="card border-0 shadow-sm rounded-4 mb-4">

                <div class="card-body p-4">

                    <h4 class="fw-bold mb-4">
                        Order Summary
                    </h4>


                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Subtotal
                        </span>

                        <span>
                            ৳ @Model.Subtotal.ToString("N2")
                        </span>

                    </div>


                    <div class="d-flex justify-content-between mb-3">

                        <span class="text-muted">
                            Shipping
                        </span>

                        <span class="text-success">
                            Free
                        </span>

                    </div>


                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-3">

                            <span class="text-muted">
                                Discount
                            </span>

                            <span class="text-success">
                                - ৳ @Model.DiscountAmount.ToString("N2")
                            </span>

                        </div>
                    }


                    @if (!string.IsNullOrWhiteSpace(Model.CouponCode))
                    {
                        <div class="d-flex justify-content-between mb-3">

                            <span class="text-muted">
                                Coupon
                            </span>

                            <span class="badge bg-success">
                                @Model.CouponCode
                            </span>

                        </div>
                    }


                    <hr />


                    <div class="d-flex justify-content-between align-items-center">

                        <span class="fw-bold fs-5">
                            Total
                        </span>

                        <span class="fw-bold fs-4 text-primary">
                            ৳ @Model.TotalAmount.ToString("N2")
                        </span>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- CURRENT ORDER STATUS -->
            <!-- ================================================= -->

            <div class="card border-0 shadow-sm rounded-4 mb-4">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-3">
                        Current Order Status
                    </h5>

                    <span class="badge @orderStatusClass px-3 py-2">
                        @Model.Status
                    </span>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- UPDATE ORDER STATUS -->
            <!-- ================================================= -->

            <div class="card border-0 shadow-sm rounded-4 mb-4">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-3">
                        Update Order Status
                    </h5>


                    <form asp-action="UpdateStatus"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />


                        <select name="status"
                                class="form-select mb-3">

                            <option value="Pending"
                                    selected="@(Model.Status == "Pending")">
                                Pending
                            </option>

                            <option value="Processing"
                                    selected="@(Model.Status == "Processing")">
                                Processing
                            </option>

                            <option value="Shipped"
                                    selected="@(Model.Status == "Shipped")">
                                Shipped
                            </option>

                            <option value="Delivered"
                                    selected="@(Model.Status == "Delivered")">
                                Delivered
                            </option>

                            <option value="Cancelled"
                                    selected="@(Model.Status == "Cancelled")">
                                Cancelled
                            </option>

                            <option value="Refunded"
                                    selected="@(Model.Status == "Refunded")">
                                Refunded
                            </option>

                        </select>


                        <button type="submit"
                                class="btn btn-primary w-100">
                            Update Order Status
                        </button>

                    </form>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- UPDATE PAYMENT STATUS -->
            <!-- ================================================= -->

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4">

                    <h5 class="fw-bold mb-3">
                        Update Payment Status
                    </h5>


                    <form asp-action="UpdatePaymentStatus"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />


                        <select name="paymentStatus"
                                class="form-select mb-3">

                           

                            <option value="Paid"
                                    selected="@(Model.PaymentStatus == "Paid")">
                                Paid
                            </option>

                            <option value="Failed"
                                    selected="@(Model.PaymentStatus == "Failed")">
                                Failed
                            </option>

                            <option value="Refunded"
                                    selected="@(Model.PaymentStatus == "Refunded")">
                                Refunded
                            </option>

                        </select>


                        <button type="submit"
                                class="btn btn-outline-primary w-100">
                            Update Payment Status
                        </button>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>