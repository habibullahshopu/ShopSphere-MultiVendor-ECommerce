@model ShopSphere.Models.Product

@{
    ViewData["Title"] = "Edit Product";
    var categories = ViewBag.Categories as List<ShopSphere.Models.Category>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-2">Edit Product ✏️</h1>
        <p class="text-muted mb-0">
            Update your product information.
        </p>
    </div>

    <a asp-area="Admin"
       asp-controller="Products"
       asp-action="Index"
       class="btn btn-outline-secondary px-4 py-2">
        ← Back to Products
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4 p-md-5">

        <!-- IMPORTANT: enctype required for image upload -->
        <form asp-action="Edit"
              asp-route-id="@Model.Id"
              method="post"
              enctype="multipart/form-data">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <!-- Product Name -->
            <div class="mb-4">
                <label asp-for="Name"
                       class="form-label fw-semibold">
                    Product Name
                </label>

                <input asp-for="Name"
                       class="form-control form-control-lg"
                       placeholder="e.g. iPhone 16 Pro Max" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>
            </div>

            <!-- Category -->
            <div class="mb-4">
                <label asp-for="CategoryId"
                       class="form-label fw-semibold">
                    Category
                </label>

                <select asp-for="CategoryId"
                        class="form-select form-select-lg">

                    <option value="">
                        -- Select Category --
                    </option>

                    @if (categories != null)
                    {
                        foreach (var category in categories)
                        {
                            <option value="@category.Id">
                                @category.Name
                            </option>
                        }
                    }

                </select>

                <span asp-validation-for="CategoryId"
                      class="text-danger">
                </span>
            </div>

            <!-- Description -->
            <div class="mb-4">
                <label asp-for="Description"
                       class="form-label fw-semibold">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="5"
                          placeholder="Enter product description"></textarea>

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>
            </div>

            <!-- Price and Stock -->
            <div class="row">

                <div class="col-md-6 mb-4">
                    <label asp-for="Price"
                           class="form-label fw-semibold">
                        Price
                    </label>

                    <input asp-for="Price"
                           type="number"
                           step="0.01"
                           class="form-control form-control-lg" />

                    <span asp-validation-for="Price"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-6 mb-4">
                    <label asp-for="StockQuantity"
                           class="form-label fw-semibold">
                        Stock Quantity
                    </label>

                    <input asp-for="StockQuantity"
                           type="number"
                           class="form-control form-control-lg" />

                    <span asp-validation-for="StockQuantity"
                          class="text-danger">
                    </span>
                </div>

            </div>

            <!-- =====================================================
                 Current Product Image
                 ===================================================== -->
            <div class="mb-4">

                <label class="form-label fw-semibold">
                    Current Product Image
                </label>

                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <div class="border rounded-4 p-3 bg-light">

                        <div class="d-flex flex-column flex-md-row
                            align-items-center gap-3">

                            <img src="@Model.ImageUrl"
                                 alt="@Model.Name"
                                 class="rounded-3 border shadow-sm"
                                 style="
                            width: 150px;
                            height: 150px;
                            object-fit: contain;
                            background: white;
                            " />

                            <div>
                                <div class="fw-semibold mb-1">
                                    Current Image
                                </div>

                                <div class="text-muted small">
                                    Upload a new image below to replace it.
                                </div>
                            </div>

                        </div>

                    </div>
                }
                else
                {
                    <div class="alert alert-light border rounded-3 mb-0">
                        📷 No product image has been added yet.
                    </div>
                }

            </div>

            <!-- =====================================================
                 Upload New Product Image
                 ===================================================== -->
            <div class="mb-4">

                <label for="imageFile"
                       class="form-label fw-semibold">
                    Upload New Product Image
                    <span class="text-muted fw-normal">
                        (Optional)
                    </span>
                </label>

                <div class="border rounded-4 p-4 bg-light">

                    <div class="text-center mb-3">

                        <div style="font-size: 3rem;">
                            🖼️
                        </div>

                        <h5 class="fw-bold mb-1">
                            Replace Product Image
                        </h5>

                        <p class="text-muted small mb-0">
                            JPG, JPEG, PNG or WebP · Maximum 5 MB
                        </p>

                    </div>

                    <input type="file"
                           id="imageFile"
                           name="imageFile"
                           class="form-control form-control-lg"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                    <div id="imageError"
                         class="text-danger small mt-2"
                         style="display:none;">
                    </div>

                    <!-- New Image Preview -->
                    <div id="imagePreviewContainer"
                         class="text-center mt-4"
                         style="display:none;">

                        <p class="fw-semibold mb-2">
                            New Image Preview
                        </p>

                        <img id="imagePreview"
                             src="#"
                             alt="New product image preview"
                             class="img-fluid rounded-4 border shadow-sm"
                             style="
                        max-height: 280px;
                        max-width: 100%;
                        object-fit: contain;
                        background: white;
                        " />

                    </div>

                </div>

            </div>

            <!-- =====================================================
                 Image URL
                 ===================================================== -->
            <div class="mb-4">

                <label asp-for="ImageUrl"
                       class="form-label fw-semibold">
                    Product Image URL
                    <span class="text-muted fw-normal">
                        (Optional)
                    </span>
                </label>

                <input asp-for="ImageUrl"
                       class="form-control form-control-lg"
                       placeholder="https://example.com/product-image.jpg" />

                <div class="form-text">
                    Leave this unchanged if you want to keep the current
                    image. Uploading a new image will replace the current
                    uploaded image.
                </div>

                <span asp-validation-for="ImageUrl"
                      class="text-danger">
                </span>

            </div>

            <!-- Active Product -->
            <div class="form-check mb-4 p-3 border rounded-3">

                <input asp-for="IsActive"
                       class="form-check-input ms-0 me-2"
                       style="float:none;" />

                <label asp-for="IsActive"
                       class="form-check-label fw-semibold">
                    Active Product
                </label>

                <div class="text-muted small mt-1">
                    Active products will be visible in the marketplace.
                </div>

            </div>

            <!-- Buttons -->
            <div class="d-flex gap-3">

                <button type="submit"
                        id="updateProductButton"
                        class="btn btn-primary px-4 py-2">
                    💾 Update Product
                </button>

                <a asp-area="Admin"
                   asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-outline-secondary px-4 py-2">
                    Cancel
                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {

            const imageInput =
                document.getElementById("imageFile");

            const imagePreview =
                document.getElementById("imagePreview");

            const imagePreviewContainer =
                document.getElementById("imagePreviewContainer");

            const imageError =
                document.getElementById("imageError");

            const updateButton =
                document.getElementById("updateProductButton");

            const maxFileSize =
                5 * 1024 * 1024;

            const allowedExtensions = [
                ".jpg",
                ".jpeg",
                ".png",
                ".webp"
            ];

            const allowedTypes = [
                "image/jpeg",
                "image/png",
                "image/webp"
            ];

            imageInput.addEventListener("change", function() {

                imageError.style.display = "none";
                imageError.textContent = "";

                imagePreviewContainer.style.display = "none";
                imagePreview.src = "#";

                const file = this.files[0];

                if (!file) {
                    return;
                }

                const fileName =
                    file.name.toLowerCase();

                const extension =
                    fileName.substring(
                        fileName.lastIndexOf(".")
                    );

                // Validate extension
                if (!allowedExtensions.includes(extension)) {

                    imageError.textContent =
                        "Only JPG, JPEG, PNG and WebP images are allowed.";

                    imageError.style.display = "block";

                    this.value = "";

                    return;
                }

                // Validate file size
                if (file.size > maxFileSize) {

                    imageError.textContent =
                        "Image size must not exceed 5 MB.";

                    imageError.style.display = "block";

                    this.value = "";

                    return;
                }

                // Validate MIME type
                if (!allowedTypes.includes(file.type)) {

                    imageError.textContent =
                        "Invalid image file type.";

                    imageError.style.display = "block";

                    this.value = "";

                    return;
                }

                // Show new image preview
                const reader = new FileReader();

                reader.onload = function(event) {

                    imagePreview.src =
                        event.target.result;

                    imagePreviewContainer.style.display =
                        "block";
                };

                reader.readAsDataURL(file);
            });

            // Prevent invalid submission
            document.querySelector("form")
                .addEventListener("submit", function(event) {

                    const file = imageInput.files[0];

                    if (file) {

                        const fileName =
                            file.name.toLowerCase();

                        const extension =
                            fileName.substring(
                                fileName.lastIndexOf(".")
                            );

                        if (!allowedExtensions.includes(extension)) {

                            event.preventDefault();

                            imageError.textContent =
                                "Only JPG, JPEG, PNG and WebP images are allowed.";

                            imageError.style.display =
                                "block";

                            return;
                        }

                        if (file.size > maxFileSize) {

                            event.preventDefault();

                            imageError.textContent =
                                "Image size must not exceed 5 MB.";

                            imageError.style.display =
                                "block";

                            return;
                        }

                        if (!allowedTypes.includes(file.type)) {

                            event.preventDefault();

                            imageError.textContent =
                                "Invalid image file type.";

                            imageError.style.display =
                                "block";

                            return;
                        }
                    }

                    updateButton.disabled = true;

                    updateButton.innerHTML =
                        "⏳ Updating Product...";
                });
        });
    </script>
}