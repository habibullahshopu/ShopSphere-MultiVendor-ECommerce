@model ShopSphere.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="d-flex justify-content-center align-items-center"
     style="min-height: 70vh;">

    <div class="card border-0 shadow-lg rounded-4"
         style="max-width: 600px; width: 100%;">

        <div class="card-body p-5 text-center">

            <!-- Delete Icon -->
            <div class="mb-3"
                 style="font-size: 60px;">
                🗑️
            </div>

            <h2 class="fw-bold mb-3">
                Delete Product?
            </h2>

            <p class="text-muted mb-2">
                Are you sure you want to delete this product?
            </p>

            <p class="text-danger small mb-4">
                This action cannot be undone.
            </p>

            <!-- Product Preview -->
            <div class="border rounded-4 p-3 mb-4 bg-light">

                <div class="d-flex align-items-center justify-content-center gap-3">

                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             alt="@Model.Name"
                             class="rounded-3 border"
                             style="width:70px; height:70px; object-fit:cover;" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center
                            bg-white border rounded-3"
                             style="width:70px; height:70px; font-size:30px;">
                            📦
                        </div>
                    }

                    <div class="text-start">
                        <div class="fw-bold fs-5">
                            @Model.Name
                        </div>

                        <div class="text-muted small">
                            📁 @(Model.Category?.Name ?? "No Category")
                        </div>

                        <div class="text-primary fw-semibold">
                            ৳ @Model.Price.ToString("N2")
                        </div>
                    </div>

                </div>

            </div>

            <!-- Buttons -->
            <div class="d-flex justify-content-center gap-3">

                <a asp-area="Admin"
                   asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-outline-secondary px-4 py-2">
                    Cancel
                </a>

                <form asp-area="Admin"
                      asp-controller="Products"
                      asp-action="Delete"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="d-inline">

                    <button type="submit"
                            class="btn btn-danger px-4 py-2">
                        🗑️ Yes, Delete Product
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>