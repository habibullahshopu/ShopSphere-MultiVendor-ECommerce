@model ShopSphere.ViewModels.VendorProductViewModel

@{
    ViewData["Title"] = "Edit Product";
    var categories = ViewBag.Categories as IEnumerable<ShopSphere.Models.Category>;
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Edit Product</h2>
        <p class="text-muted mb-0">
            Update your product information and inventory.
        </p>
    </div>


    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <form asp-area="Vendor"
                  asp-controller="Products"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- Product Name -->

                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Enter product name" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>


                <!-- Description -->

                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label fw-semibold">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5"
                              placeholder="Describe your product">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>


                <div class="row">

                    <!-- Price -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Price"
                               class="form-label fw-semibold">
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                ৳
                            </span>

                            <input asp-for="Price"
                                   class="form-control"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   placeholder="0.00" />

                        </div>

                        <span asp-validation-for="Price"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Stock -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="StockQuantity"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="StockQuantity"
                               class="form-control"
                               type="number"
                               min="0"
                               placeholder="Enter stock quantity" />

                        <span asp-validation-for="StockQuantity"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- Category -->

                <div class="mb-3">

                    <label asp-for="CategoryId"
                           class="form-label fw-semibold">
                    </label>

                    <select asp-for="CategoryId"
                            class="form-select">

                        <option value="">
                            -- Select Category --
                        </option>

                        @if (categories != null)
                        {
                            foreach (var category in categories)
                            {
                                <option value="@category.Id">
                                    @category.Name
                                </option>
                            }
                        }

                    </select>

                    <span asp-validation-for="CategoryId"
                          class="text-danger">
                    </span>

                </div>


                <!-- Image URL -->

                <div class="mb-3">

                    <label asp-for="ImageUrl"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="ImageUrl"
                           class="form-control"
                           placeholder="https://example.com/product-image.jpg" />

                    <span asp-validation-for="ImageUrl"
                          class="text-danger">
                    </span>

                    <small class="text-muted">
                        Enter a publicly accessible image URL.
                    </small>

                </div>


                <!-- Active -->

                <div class="form-check mb-4">

                    <input asp-for="IsActive"
                           class="form-check-input" />

                    <label asp-for="IsActive"
                           class="form-check-label fw-semibold">
                    </label>

                </div>


                <!-- Buttons -->

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary px-4">
                        Save Changes
                    </button>

                    <a asp-area="Vendor"
                       asp-controller="Products"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}