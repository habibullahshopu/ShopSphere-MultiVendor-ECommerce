@{
    ViewData["Title"] = "Track Order";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="text-center mb-4">
                <div style="font-size:48px;">📦</div>

                <h1 class="fw-bold mb-2">
                    Track Your Order
                </h1>

                <p class="text-muted">
                    Enter your Order ID and customer email to check your order status.
                </p>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger rounded-3">
                    @TempData["ErrorMessage"]
                </div>
            }

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <form asp-action="Index"
                          asp-controller="TrackOrder"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label for="orderId" class="form-label fw-semibold">
                                Order ID
                            </label>

                            <input type="number"
                                   id="orderId"
                                   name="orderId"
                                   class="form-control form-control-lg"
                                   placeholder="Example: 38"
                                   min="1"
                                   required />

                            <div class="form-text">
                                Enter the Order ID shown in your order confirmation.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="email" class="form-label fw-semibold">
                                Customer Email
                            </label>

                            <input type="email"
                                   id="email"
                                   name="email"
                                   class="form-control form-control-lg"
                                   placeholder="Enter your order email"
                                   required />
                        </div>

                        <button type="submit"
                                class="btn btn-primary btn-lg w-100 rounded-3">
                            🔍 Track Order
                        </button>

                    </form>

                </div>
            </div>

            <div class="text-center mt-4">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="text-decoration-none">
                    ← Back to Home
                </a>
            </div>

        </div>
    </div>
</div>