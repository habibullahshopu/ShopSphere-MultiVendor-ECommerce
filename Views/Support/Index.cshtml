@{
    ViewData["Title"] = "Help & Support";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill mb-3">
            ShopSphere Support
        </span>

        <h1 class="fw-bold">How Can We Help?</h1>

        <p class="text-muted mx-auto" style="max-width: 650px;">
            Need help with your order, payment, account, return, or anything else?
            Our support team is here to help.
        </p>
    </div>

    <div class="row g-4 justify-content-center">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 text-center p-4">
                <div class="fs-1 mb-3">📦</div>
                <h5 class="fw-bold">Order Support</h5>
                <p class="text-muted small mb-0">
                    Get help with orders, delivery and tracking.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 text-center p-4">
                <div class="fs-1 mb-3">💳</div>
                <h5 class="fw-bold">Payment Support</h5>
                <p class="text-muted small mb-0">
                    Having trouble with payment or checkout?
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 rounded-4 text-center p-4">
                <div class="fs-1 mb-3">🔄</div>
                <h5 class="fw-bold">Return & Refund</h5>
                <p class="text-muted small mb-0">
                    Need assistance with a return or refund request?
                </p>
            </div>
        </div>

    </div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm"
             role="alert">
            <strong>✅ Success!</strong>
            <div class="mt-1">
                @TempData["SuccessMessage"]
            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm"
             role="alert">
            <strong>⚠️ Please check your information.</strong>
            <div class="mt-1">
                @TempData["ErrorMessage"]
            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }
    <div class="card border-0 shadow-sm rounded-4 mt-5">
        <div class="card-body p-4 p-md-5">

            <h4 class="fw-bold mb-2">Contact ShopSphere Support</h4>

            <p class="text-muted mb-4">
                Send us your question and our support team will get back to you.
            </p>

            <form method="post">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Your Name
                        </label>

                        <input type="text"
                               name="name"
                               class="form-control form-control-lg"
                               placeholder="Enter your name"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Email Address
                        </label>

                        <input type="email"
                               name="email"
                               class="form-control form-control-lg"
                               placeholder="Enter your email"
                               required />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">
                            Subject
                        </label>

                        <input type="text"
                               name="subject"
                               class="form-control form-control-lg"
                               placeholder="What do you need help with?"
                               required />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-semibold">
                            Message
                        </label>

                        <textarea name="message"
                                  class="form-control"
                                  rows="6"
                                  placeholder="Describe your issue..."
                                  required></textarea>
                    </div>

                    <div class="col-12 text-end">
                        <button type="submit"
                                class="btn btn-primary btn-lg px-4 rounded-3">
                            📩 Send Message
                        </button>
                    </div>

                </div>

            </form>

        </div>
    </div>

</div>